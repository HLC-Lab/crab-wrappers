{
    "leonardo": {
        "description": "Leonardo Cluster @ CINECA",
        "scheduler": "slurm",
        "launcher": "srun",
        "launchers": {
            "srun": {
                "flags": [
                    "--cpu-bind=socket"
                ]
            }
        },
        "env": {
            "UCX_IB_SL": "1",
            "CRAB_IB_DEVICES": "mlx5_0#mlx5_1#mlx5_2#mlx5_3",
            "NCCL_IB_SL": "${UCX_IB_SL}"
        },
        "sbatch": [
            "--account=<YOUR_ACCOUNT>",
            "--partition=boost_usr_prod",
            "--gres=tmpfs:0"
        ],
        "header": [
            "module purge"
        ]
    }
}
